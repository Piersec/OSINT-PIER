# Token compartilhado somente entre o backend do OSINT Pier e o gateway.
# Gere um valor aleatório com pelo menos 32 caracteres e não o publique no Git.
COMMAND_TOOLS_API_TOKEN=gere-um-token-aleatorio-com-mais-de-32-caracteres

# Gobuster fica desligado por padrão. Ative somente em um ambiente autorizado.
COMMAND_TOOLS_ENABLE_GOBUSTER=false

# Use outra porta se o host já utilizar 8080.
COMMAND_TOOLS_GATEWAY_PORT=8080

# Por segurança, o gateway fica acessível apenas no host e deve ser publicado
# por um proxy HTTPS/túnel autorizado quando o backend estiver fora da rede.
COMMAND_TOOLS_GATEWAY_BIND_ADDRESS=127.0.0.1
