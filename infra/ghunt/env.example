# Copie este arquivo para .env antes de executar docker compose.
# Use o mesmo token na credencial GHUNT_API_TOKEN do cofre do OSINT Pier.
GHUNT_API_TOKEN=gere-um-token-longo-e-aleatorio
GHUNT_TIMEOUT_SECONDS=105

# Use outra porta se o host já utilizar 8080.
GHUNT_GATEWAY_PORT=8080

# Por segurança, o gateway fica acessível apenas no host e deve ser publicado
# por um proxy HTTPS/túnel autorizado quando o backend estiver fora da rede.
GHUNT_GATEWAY_BIND_ADDRESS=127.0.0.1
