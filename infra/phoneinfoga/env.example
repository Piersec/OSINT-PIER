# Copie este arquivo para .env antes de executar docker compose.
# Gere um valor aleatório e use o mesmo token na credencial
# PHONEINFOGA_API_TOKEN do cofre do OSINT Pier.
PHONEINFOGA_API_TOKEN=gere-um-token-longo-e-aleatorio

# Opcional: permite usar o PhoneInfoga diretamente com seus próprios scanners.
# O adapter do OSINT Pier também pode enviar essas credenciais por requisição
# quando elas forem cadastradas no cofre da aplicação.
NUMVERIFY_API_KEY=
GOOGLECSE_CX=
GOOGLE_API_KEY=
