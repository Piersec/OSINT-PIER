# Host local da API Fastify. Mantenha 127.0.0.1 para não expor o serviço na rede.
API_HOST=127.0.0.1

# Porta da API Fastify.
PORT=3000

# Origem permitida no navegador durante o desenvolvimento.
WEB_ORIGIN=http://localhost:5173

# URL opcional de uma API Fastify separada. Em Next/Vercel, deixe vazio para
# usar a rota same-origin /api integrada ao deploy.
# NEXT_PUBLIC_API_URL=http://localhost:3000

# Timeout padrão de cada plugin em milissegundos.
CHECK_TIMEOUT_MS=10000

# Cache efêmero de resultados bem-sucedidos. Use 0 no TTL para desabilitar.
CHECK_CACHE_TTL_MS=300000
CHECK_CACHE_MAX_ENTRIES=1000

# Limite combinado dos endpoints POST /api/checks/:id por IP e janela.
ANALYSIS_RATE_LIMIT_MAX=60
ANALYSIS_RATE_LIMIT_WINDOW_MS=60000

# Token exigido pelo painel interno para adicionar/remover credenciais.
# Gere um valor aleatório longo; nunca use este texto como token real.
ADMIN_TOKEN=gere-um-token-aleatorio-longo

# Chave mestra de 32 bytes codificada em base64 para o cofre AES-256-GCM.
# Exemplo de geração: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=gere-32-bytes-em-base64

# Caminho opcional do arquivo criptografado. O padrão é .data/credentials.enc.
# CREDENTIAL_STORE_PATH=C:/dados/osint-pier/credentials.enc

# Caminho opcional das flags de plugins habilitados. O padrão é
# .data/check-settings.json. O arquivo contém somente configurações booleanas, sem segredos.
# CHECK_SETTINGS_PATH=C:/dados/osint-pier/check-settings.json

# Chaves de integrações opcionais. Prefira configurá-las pelo painel; estas variáveis
# funcionam como fallback para deploys automatizados.
# Obtenha em https://www.virustotal.com/gui/my-apikey e use uma licença compatível com
# seu fluxo interno. A API pública possui restrições de uso comercial/empresarial.
# VIRUSTOTAL_API_KEY=

# Obtenha no painel da conta em https://www.abuseipdb.com/account/api
# ABUSEIPDB_API_KEY=

# Supabase opcional para persistir o histórico agregado de análises.
# O backend usa somente a REST API com a service role key; nunca exponha essa chave
# em variáveis VITE_ ou no navegador. A tabela e o RLS são criados pela migração
# create_analysis_history.
# SUPABASE_URL=https://doqnyijzaogqiwkuygcs.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_HISTORY_LIMIT=50

# Integrações externas adicionadas na Fase 7. Prefira o cofre interno para armazená-las.
# Shodan: https://developer.shodan.io/api/requirements
# SHODAN_API_KEY=
# Hunter.io: https://hunter.io/api-documentation/v2
# HUNTER_API_KEY=
